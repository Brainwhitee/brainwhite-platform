# BrainWhite Platform Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=development-secret-key-change-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
POSTGRES_USER=brainwhite
POSTGRES_PASSWORD=brainwhite_dev
POSTGRES_DB=brainwhite
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://brainwhite:brainwhite_dev@postgres:5432/brainwhite
SYNC_DATABASE_URL=postgresql://brainwhite:brainwhite_dev@postgres:5432/brainwhite

# Redis & Background Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# GitHub App Configuration (Optional for Wave 1, required for Stage 2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI Provider Configuration (Default to fake/offline for testing)
AI_PROVIDER=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
